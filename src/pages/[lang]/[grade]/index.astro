---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { copy, courses, grades, languages, localizedNoteCopy, semesters, sortNotesByDisplayOrder, type GradeId, type Lang } from "../../../data/site";

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    grades.map((grade) => ({ params: { lang, grade: grade.id } }))
  );
}

const lang = Astro.params.lang as Lang;
const gradeId = Astro.params.grade as GradeId;
const grade = grades.find((item) => item.id === gradeId)!;
const t = copy[lang];
const message = grade.message?.[lang];
const year1Courses = courses
  .filter((item) => item.grade === "year-1")
  .sort((a, b) => Number(a.semester === "spring") - Number(b.semester === "spring"));
const applicationEntries = gradeId === "application"
  ? (await getCollection("notes"))
      .filter((entry) => entry.data.published && entry.data.course === "application")
      .sort(sortNotesByDisplayOrder)
  : [];
const postPath = (entryId: string) => `/${lang}/posts/${entryId}/`;
---

<BaseLayout lang={lang} title={grade.label[lang]}>
  <div class="container page-head">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <span><a href={`/${lang}/`}>{lang === "zh" ? "首页" : "Home"}</a></span>
      <span>{grade.label[lang]}</span>
    </nav>
    <p class="eyebrow">{
      message
        ? (lang === "zh" ? "一些肺腑之言" : "A few honest words")
        : gradeId === "application"
          ? (lang === "zh" ? "申请" : "Application")
          : t.chooseSemester
    }</p>
    <h1>{grade.label[lang]}</h1>
    {message ? (
      <p class="grade-message" set:html={message} />
    ) : (
      <p class="hero-copy">{grade.description[lang]}</p>
    )}
  </div>
  {gradeId === "application" && (
    <section class="container section">
      <div class="content-list">
        <h2>{t.recommendations} <span class="meta">({applicationEntries.length})</span></h2>
        {applicationEntries.length ? applicationEntries.map((entry) => {
          const item = localizedNoteCopy(entry, lang);
          return (
            <a class="article-link" href={postPath(entry.id)}>
              <h3>{item.title}</h3>
              {item.description.trim() && <p class="meta">{item.description}</p>}
            </a>
          );
        }) : <p class="status">{t.noContent}</p>}
      </div>
    </section>
  )}
  {gradeId === "year-1" && (
    <section class="container section">
      <div class="two-grid">
        {year1Courses.map((course) => {
          const semester = semesters.find((item) => item.id === course.semester)!;
          return (
            <a class="link-row" href={`/${lang}/${grade.id}/${course.semester}/${course.slug}/`}>
              <div>
                <span class="code">{lang === "zh" ? `大一${semester.label.zh.replace("学期", "")}` : `Year 1 · ${semester.label.en}`}</span>
                <h2>{course.title[lang]}</h2>
                <p>{course.description[lang]}</p>
              </div>
              <span aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </section>
  )}
  {gradeId !== "year-1" && gradeId !== "application" && (
    <section class="container section">
      <div class="section-head">
        <h2>{t.chooseSemester}</h2>
      </div>
      <div class="two-grid">
        {semesters.map((semester, index) => (
          <a class="link-row" href={`/${lang}/${grade.id}/${semester.id}/`}>
            <div>
              <span class="code">0{index + 1}</span>
              <h2>{semester.label[lang]}</h2>
            </div>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
