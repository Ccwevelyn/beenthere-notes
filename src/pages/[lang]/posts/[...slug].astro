---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { copy, courses, languages } from "../../../data/site";

export async function getStaticPaths() {
  const entries = await getCollection("notes", ({ data }) => data.published);
  return languages.flatMap((lang) =>
    entries.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { entry, lang }
    }))
  );
}

const { entry, lang } = Astro.props;
const { Content, headings } = await render(entry);
const t = copy[lang];
const course = courses.find((item) => item.slug === entry.data.course);
const articleSlug = entry.id;
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const pdfAttachments = entry.data.attachments.filter((item) => /\.pdf$/i.test(item.file));
const docxAttachments = entry.data.attachments.filter((item) => /\.docx$/i.test(item.file));
const otherAttachments = entry.data.attachments.filter(
  (item) => !/\.pdf$/i.test(item.file) && !/\.docx$/i.test(item.file)
);
const primaryDocx = docxAttachments[0];
const hasDocx = Boolean(primaryDocx);
const docxFileName = primaryDocx?.file.split("/").pop() || "document.docx";
const showToc = toc.length > 0 && !hasDocx;
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description}>
  <div class="article-shell">
    {showToc && (
      <aside class="article-toc" aria-label={lang === "zh" ? "目录" : "Contents"}>
        <p class="toc-title">{lang === "zh" ? "目录" : "Contents"}</p>
        <nav>
          <ul>
            {toc.map((heading) => (
              <li class={`toc-depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}

    <article class:list={["article-wrap", { "has-toc": showToc, "has-docx": hasDocx }]}>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <span><a href={`/${lang}/`}>{lang === "zh" ? "首页" : "Home"}</a></span>
        {course && (
          <span>
            <a href={`/${lang}/${entry.data.grade}/${entry.data.semester}/${course.slug}/`}>
              {course.title[lang]}
            </a>
          </span>
        )}
        <span>{entry.data.title}</span>
      </nav>
      <span class="pill">{entry.data.type === "note" ? t.notes : t.tips}</span>
      <h1>{entry.data.title}</h1>
      {entry.data.description.trim() && <p class="hero-copy">{entry.data.description}</p>}
      <div class="article-meta">
        <time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-GB")}</time>
        <span>·</span>
        <span
          id="view-count"
          data-slug={articleSlug}
          data-suffix={t.views}
        >— {t.views}</span>
      </div>

      {hasDocx && primaryDocx && (
        <section
          class="word-shell"
          data-docx-viewer
          data-docx-url={primaryDocx.file}
          data-error-text={lang === "zh"
            ? "Word 预览加载失败，请下载原文件或展开下方文本版。"
            : "Word preview failed. Download the file or expand the text version below."}
          aria-label={lang === "zh" ? "Word 预览" : "Word preview"}
        >
          <div class="word-chrome">
            <div class="word-chrome-left">
              <span class="word-chrome-icon" aria-hidden="true">W</span>
              <div class="word-chrome-meta">
                <strong>{primaryDocx.label || docxFileName}</strong>
                <span>{docxFileName}</span>
              </div>
            </div>
            <a class="word-download" href={primaryDocx.file} download={docxFileName}>
              {lang === "zh" ? "下载 Word" : "Download Word"}
            </a>
          </div>
          <div class="word-stage">
            <p class="word-status" data-docx-status>
              {lang === "zh" ? "正在加载 Word 预览…" : "Loading Word preview…"}
            </p>
            <div class="word-canvas" data-docx-canvas></div>
          </div>
        </section>
      )}

      {pdfAttachments.length > 0 && (
        <div class="article-pdf-bar">
          {pdfAttachments.map((attachment) => (
            <a class="article-pdf-link" href={attachment.file} target="_blank" rel="noopener">
              {lang === "zh" ? "打开 PDF" : "Open PDF"}
              {attachment.label ? ` · ${attachment.label}` : ""}
            </a>
          ))}
        </div>
      )}

      {hasDocx ? (
        <details class="docx-text-fallback" data-docx-text-fallback>
          <summary>{lang === "zh" ? "文本版（可搜索）" : "Text version (searchable)"}</summary>
          <div class="prose">
            <Content />
          </div>
        </details>
      ) : (
        <div class="prose">
          <Content />
        </div>
      )}

      {otherAttachments.length > 0 && (
        <section class="attachments" id="attachments">
          <h2>{lang === "zh" ? "附件" : "Attachments"}</h2>
          <ul>
            {otherAttachments.map((attachment) => {
              const isImage = /\.(png|jpe?g|gif|webp|avif|svg)$/i.test(attachment.file);
              return (
                <li>
                  {isImage ? (
                    <figure>
                      <img
                        src={attachment.file}
                        alt={attachment.label}
                        loading="lazy"
                        referrerpolicy="no-referrer"
                      />
                      <figcaption>{attachment.label}</figcaption>
                    </figure>
                  ) : (
                    <a href={attachment.file} target="_blank" rel="noopener">
                      <span class="attachment-icon" aria-hidden="true">FILE</span>
                      <span>{attachment.label}</span>
                      <span class="meta">{lang === "zh" ? "点击查看 / 下载" : "View / download"}</span>
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </article>
  </div>
</BaseLayout>
